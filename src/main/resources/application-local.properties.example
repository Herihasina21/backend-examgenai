# Renseigner :
# - le mot de passe de votre PostgreSQL local
# - la cle Gemini (https://aistudio.google.com/apikey)
# En production (Render) : utiliser les variables d'environnement
# SPRING_DATASOURCE_* et GEMINI_API_KEY (ne pas committer de secrets).

spring.datasource.password=

